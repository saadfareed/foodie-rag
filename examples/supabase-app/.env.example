# ---- this app ------------------------------------------------------------------------------
PORT=3000
# Anything other than `production` leaves the session cookie without the `Secure` flag, so the
# example can run on plain http://localhost. Set it to `production` anywhere real.
NODE_ENV=development
# Signs the httpOnly session cookie. Anything shorter than 32 characters -- or any value still
# containing CHANGE_ME -- is refused at startup, so this shows the shape without being usable.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=CHANGE_ME-paste-the-generated-32-byte-value-here
SESSION_TTL_SECONDS=3600

# ---- the chat gateway (app/api/) -----------------------------------------------------------
GATEWAY_URL=http://127.0.0.1:8000
# One of the secrets in the gateway's WIDGET_API_KEYS. Server-side only -- if this ever reaches a
# browser, the holder can mint a session for any user with any data scope. Refused at startup
# while it still contains CHANGE_ME.
WIDGET_API_KEY=CHANGE_ME-shared-secret-your-host-app-sends

# ---- Supabase (optional) -------------------------------------------------------------------
# Only needed for the password sign-in path. The one-time-code path above needs none of this --
# it resolves identities through the gateway, which is the only thing holding a Mongo credential.
# Project Settings -> API. The anon key is public (it ships to the browser); the service-role key
# is not, and is only used here to read the app_users mapping.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=CHANGE_ME-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME-supabase-service-role-key

# ---- sign-in: email one-time code ----------------------------------------------------------
# `console` (default) prints the code to this server's log instead of sending it, so the whole
# flow works with no provider account. `resend` and `sendgrid` send for real and need an API key.
OTP_EMAIL_PROVIDER=console
# Only read when OTP_EMAIL_PROVIDER is `resend` or `sendgrid`; with `console` it stays empty and
# the server refuses to start if you switch provider without setting it.
OTP_EMAIL_API_KEY=
OTP_EMAIL_FROM=login@example.test
APP_NAME=Northwind Portal
# How long a code is valid. The window in which a forwarded or shoulder-surfed code still works.
OTP_CODE_TTL_SECONDS=600
# Guesses allowed against one code before it is discarded. Six digits is a million combinations;
# unlimited attempts is none.
OTP_MAX_ATTEMPTS=5
# Codes one address may request per hour. Without this, sign-in is a free mailbox flooder.
OTP_REQUESTS_PER_HOUR=5

# ---- demo ----------------------------------------------------------------------------------
# Adds buttons that sign in as a role without proving anything, so the role scoping can be
# demonstrated with no email at all. Never enable this anywhere real.
DEMO_MODE=false
