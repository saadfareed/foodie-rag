# Every variable this app reads, at the default app/config.py applies when it is unset.
# Only the six at the top are required; everything else can be deleted and behaves identically.
# Full prose reference: README.md ("Setup"), docs/web-plugin.md, docs/authorization.md.

# ---- Required ---------------------------------------------------------------------------------
# Slack app credentials (from api.slack.com/apps -> your app)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=...

# Google Gemini API key (free tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY=...

# MongoDB -- use a READ-ONLY database user.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net
MONGODB_DB_NAME=your_database_name

# ---- Gemini (app/llm/) --------------------------------------------------------------------------
GEMINI_MODEL=gemini-3-flash-preview
# Tried in order, only on a 429 from GEMINI_MODEL -- free-tier quota is per-model. Empty is the
# default: falling back to an unconfirmed model name would just fail differently. Uncomment and
# name models you have actually confirmed exist for your key.
#
# Verified against a real key on 2026-08-03 -- Gemini's lineup and per-account access move fast
# (whole model families get retired), so re-verify rather than trusting this list:
#   gemini-3.6-flash      -> works
#   gemini-3.5-flash-lite -> works
#   gemini-2.5-flash(-lite), gemini-2.5-pro -> 404 "no longer available to new users" / 429
#   gemini-3-flash (no "-preview")          -> 404, not a real model id
#GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=
# If you're on the Gemini free tier, its daily request quota is set by Google (as low as
# 20/day for some models) -- the multi-domain agent graph uses several calls per question, so
# set this comfortably below your real quota to fail with a clean message instead of a raw 429
# mid-question. 0 (default) means unlimited on our side, i.e. purely subject to Google's cap.
GEMINI_DAILY_CALL_BUDGET=0
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_DELAY_SECONDS=1.0
# Hard wall-clock ceiling on retrying ONE call, measured from the start of the first attempt.
# It MUST be larger than GEMINI_REQUEST_TIMEOUT_MS below -- ideally twice it, to fit a second
# attempt. The budget covers the attempts as well as the backoff between them, so if a single
# attempt can outlast it, every slow failure (a 504, or the timeout itself) is refused the retry
# it was classified as deserving. This pair shipped as 8.0/15000 and did exactly that; the app
# now warns at startup if they disagree again.
GEMINI_MAX_RETRY_SECONDS=16.0
# Client-side HTTP timeout per Gemini call; past it the call is retried, not failed outright.
# This, not the ceiling above, is what bounds per-question latency -- failing early is what leaves
# room inside the ceiling for a retry.
# MINIMUM 10000: the API rejects a shorter deadline on EVERY call with 400 INVALID_ARGUMENT
# ("Manually set deadline 8s is too short"), so a smaller number stops the bot working entirely
# rather than making it faster. Anything lower is clamped up to 10000 and warned about at startup.
GEMINI_REQUEST_TIMEOUT_MS=10000
# Rows serialized into the answer prompt, independent of MONGODB_MAX_RESULT_LIMIT.
GEMINI_ANSWER_MAX_ROWS=30
# Output-token cap for query generation only. Generous on purpose: on thinking models reasoning
# tokens count against it, and a small cap truncates the JSON mid-object instead of saving time.
GEMINI_QUERY_MAX_OUTPUT_TOKENS=2048
# 0 = thinking off (the real latency fix), -1 = automatic. Query generation is structured
# extraction, not open-ended reasoning.
GEMINI_QUERY_THINKING_BUDGET=0

# Circuit breaker (app/llm/circuit_breaker.py): after this many consecutive Gemini failures,
# fail fast for the cooldown period instead of retrying -- protects the Socket Mode thread pool
# during a sustained Gemini outage. 0 threshold disables the breaker.
GEMINI_CIRCUIT_BREAKER_THRESHOLD=5
GEMINI_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30.0

# ---- MongoDB (app/db/) --------------------------------------------------------------------------
# Comma-separated list of collections this bot is allowed to query. Empty = no allow-list.
MONGODB_ALLOWED_COLLECTIONS=collection_one,collection_two
MONGODB_QUERY_TIMEOUT_MS=8000
MONGODB_MAX_RESULT_LIMIT=200
# pymongo's own server-selection default is 30s; left unset a slow Mongo eats that much of a
# request before the query even starts.
MONGODB_SERVER_SELECTION_TIMEOUT_MS=3000
MONGODB_CONNECT_TIMEOUT_MS=3000
MONGODB_SOCKET_TIMEOUT_MS=8000
# Should stay >= SLACK_SOCKET_MODE_CONCURRENCY * (AGENT_MAX_FAN_OUT + 1), or DB connections
# become the concurrency ceiling. app.main warns at startup if it doesn't hold.
MONGODB_MAX_POOL_SIZE=40
# Clamp on a "nearby" query's radius, so it can't silently become a full scan.
MONGODB_MAX_GEO_RADIUS_M=50000

# ---- Slack adapter (app/slack/) -----------------------------------------------------------------
# Comma-separated allow-lists. Empty is the default and means OPEN -- every channel, every user.
# Filling these in is how you close that; the commented lines show the id format.
#SLACK_ALLOWED_CHANNEL_IDS=C01234567AB,C08901234CD
#SLACK_ALLOWED_USER_IDS=U01234567AB
SLACK_ALLOWED_CHANNEL_IDS=
SLACK_ALLOWED_USER_IDS=
# Thread pool size for the Socket Mode client (slack_sdk's own default, explicit here so it is
# tuned alongside MONGODB_MAX_POOL_SIZE rather than left implicit).
SLACK_SOCKET_MODE_CONCURRENCY=10
# How long a `/login` vendor session stays valid. 0 means never expires.
VENDOR_SESSION_TTL_SECONDS=3600

# ---- Multi-domain agent routing (app/agents/) ---------------------------------------------------
AGENT_CLASSIFIER_MIN_CONFIDENCE=0.55
AGENT_MAX_FAN_OUT=3
AGENT_MAX_CLARIFICATION_ROUNDS=2
CLARIFICATION_CACHE_TTL_SECONDS=300
# How long a (channel, user)'s last resolved question stays available for a short follow-up
# ("what about the total amount?") to be folded into -- same-session, single-turn only, never a
# growing transcript (see app/rag/conversation_context.py).
CONVERSATION_CONTEXT_TTL_SECONDS=300
# How long the "should I clear that context and answer this as a new question?" prompt stays
# valid before a later message is treated as an ordinary fresh question instead of a reply to it
# (see app/rag/context_switch_cache.py). The reply itself, and the reset command ("reset" /
# "new topic" / "start over" / "forget that"), are matched by exact phrase, never sent to Gemini.
CONTEXT_SWITCH_CONFIRMATION_TTL_SECONDS=120

# ---- Answer cache (app/rag/answer_cache.py) -----------------------------------------------------
# Per-channel cache of complete answers (text AND any generated file), keyed including the
# authenticated scope so one tenant's answer can never replay to another.
ANSWER_CACHE_TTL_SECONDS=1800
ANSWER_CACHE_MAX_ENTRIES=500

# ---- Rate limiting ------------------------------------------------------------------------------
# Per-(channel,user) rate limit -- independent of GEMINI_DAILY_CALL_BUDGET above, which is a
# *shared* ceiling across every user. 0 disables this, and stays the master switch:
# a per-role override below can lower or raise the limit but can never turn limiting back on.
USER_RATE_LIMIT_PER_MINUTE=10
USER_RATE_LIMIT_WINDOW_SECONDS=60.0
# Optional per-role overrides, as `role:limit` pairs. An operator answering a support question
# and a customer poking at a chat widget are not the same load, and one flat number has to be set
# for the worst of them. Empty (the default) means every role shares the flat limit above.
RATE_LIMIT_BY_ROLE=admin:60,vendor:20,customer:10
# Questions ONE identity may ask per UTC day. The window above stops a burst; this stops a slow
# drain -- a question every thirty seconds passes every per-minute check and still exhausts a
# free-tier quota by lunchtime. 0 disables it.
USER_DAILY_QUESTION_LIMIT=0

# ---- Report generation (app/generators/) --------------------------------------------------------
REPORT_MAX_ROWS=1000
REPORT_MAX_COLUMNS=12
# Above this many categories a pie becomes a bar chart.
REPORT_MAX_PIE_SLICES=8
# Bounded pool for PDF/XLSX rendering, so WeasyPrint can't saturate every worker at once.
REPORT_RENDER_CONCURRENCY=2
REPORT_RENDER_TIMEOUT_SECONDS=25.0
# Fallback title; a report usually takes its title from the question instead.
REPORT_TITLE=Data Report

# ---- Audit log (app/audit/logger.py) ------------------------------------------------------------
AUDIT_LOG_LEVEL=INFO
# Optional second audit-log sink alongside stdout. Empty is the default and means stdout only;
# set a path to persist audit events across container restarts.
#AUDIT_LOG_FILE=/var/log/ragchat/audit.log
AUDIT_LOG_FILE=
AUDIT_LOG_FILE_MAX_BYTES=10485760
AUDIT_LOG_FILE_BACKUP_COUNT=5

# ---- Field policy (app/security/field_policy.py) ------------------------------------------------
# Extra field names to drop from every row, on top of the built-in internal/secret/contact
# patterns in app/security/field_policy.py. Empty is the default; matched case-insensitively.
#SECURITY_EXTRA_DENIED_FIELDS=internal_notes,legacy_ssn
SECURITY_EXTRA_DENIED_FIELDS=

# ---- Web chat plugin (app/api/, docs/web-plugin.md) ---------------------------------------------
# Only needed to run the embeddable chat widget's gateway (`python -m app.api.main`). The Slack
# bot ignores all of them, so a Slack-only deployment can leave this whole block out.
#
# The two below show the SHAPE of a credential, not a usable one. Both values contain CHANGE_ME,
# and the gateway refuses to start while they still do -- a sample that shipped a working signing
# key would be worse than one that shipped none, since every deployment that copied it without
# reading would share a secret printed in this repository.
#
# Host-application server keys. `tenant:secret` or a bare `secret`. A list so a key can be rotated
# without downtime, and so one gateway can serve several host apps. These are server-side only:
# anyone holding one can mint a chat session for any user with any data scope.
WIDGET_API_KEYS=default:CHANGE_ME-shared-secret-your-host-app-sends
# Signs the short-lived session tokens the browser holds. At least 32 characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
WIDGET_JWT_SECRET=CHANGE_ME-paste-the-generated-value-here
# Browser origins allowed to call the gateway. Empty (default) means any origin, and warns at
# startup. Set it to the origins that actually embed the widget.
WIDGET_ALLOWED_ORIGINS=https://app.example.com
# Lifetime of a browser session token -- and therefore the worst-case delay before a suspended
# account stops being answered. Renewal re-checks the account, so this IS the revocation
# mechanism: lower it and revocation tightens proportionally.
WIDGET_SESSION_TTL_SECONDS=900
# How long a generated CSV/XLSX/PDF stays downloadable before it is dropped from memory.
WIDGET_FILE_TTL_SECONDS=600
WIDGET_MAX_CACHED_FILES=200
# Bounds what a browser may post, before anything downstream sees it.
WIDGET_MAX_QUESTION_CHARS=2000
# Loopback by default -- binding every interface is a deployment decision, not a default.
WIDGET_API_HOST=127.0.0.1
WIDGET_API_PORT=8000
# Serves a usable chat playground at the gateway's `/`: an email/password sign-in form against
# your `users` collection, and a session minted WITHOUT a host-app key -- a deliberate hole in
# this service's one credential boundary. Off by default, refused for any caller that isn't on
# this machine even when on, and still subject to WIDGET_ALLOWED_SESSION_ROLES and the same
# live-account check as a real session. Local development only. The landing page itself is always
# served; only the minting is gated. `python -m app.db.seed_users` creates accounts to sign in
# with (including one admin) and prints their addresses and password.
WIDGET_DEV_PLAYGROUND=false

# ---- Shared state (app/state/, docs/scaling.md) -------------------------------------------------
# Where the stateful guardrails keep their state: the answer cache, the conversation caches, the
# rate limiter, the daily Gemini budget, the circuit breaker, generated reports, `/login` sessions.
#
# "memory" (default) is in-process and needs nothing else -- correct, fast, and single-replica by
# construction. Switch to "redis" BEFORE running a second instance: without it each replica
# enforces its own daily budget and its own rate limit, so N replicas admit N times the traffic
# those limits were set to allow, and a follow-up handled by another replica loses its context.
# Requires `pip install redis`.
STATE_BACKEND=memory
# Empty by default; only read when STATE_BACKEND=redis.
REDIS_URL=redis://localhost:6379/0
# Namespaces every key, so this app can share a Redis with something else.
STATE_KEY_PREFIX=ragchat

# ---- Roles and row-level access (app/security/roles.py) -----------------------------------------
# Three roles, mapped from the `usertype` your data already carries (1 = customer, 2 = vendor):
#
#   admin     every domain, unfiltered
#   vendor    their own orders, their own vendor record, and the customers who ordered from them
#   customer  their own orders, their own account, and the vendor directory
#
# The default is DENY: a request with no role reads nothing.
#
# Cap on a computed authorization scope -- today, the customers a vendor is entitled to see. Past
# it the domain is refused with "narrow your question" rather than answered from a truncated set,
# because a truncated set produces an answer that looks complete and is about an arbitrary subset.
RBAC_MAX_AUTHORIZED_IDS=1000
# The role a Slack user has before `/login`. Slack access is already gated by the allow-lists
# above, and an un-logged-in Slack user has always been answered unfiltered, so this default
# preserves that. Set it to `anonymous` if the people in those channels are not all trusted as
# operators. The web adapter has no equivalent default -- its tokens must name a role.
SLACK_DEFAULT_ROLE=admin
# Which roles a host application's key may assert at POST /v1/session. `admin` is deliberately
# absent: a host key is a long-lived secret on someone else's server, and leaking one should not
# include the ability to mint an unrestricted session. Add it only for an internal console -- or,
# locally, to sign in to the playground as the seeded operator account.
WIDGET_ALLOWED_SESSION_ROLES=customer,vendor
# Re-check an asserted vendor/customer against `users` when a session is minted: still there,
# still active? This is offboarding, not distrust of the host app -- without it, a suspended
# vendor whose host application still has them logged in keeps reading until their token expires.
# One indexed lookup per sign-in, not per question. Admins are always skipped -- an operator may
# have a row (usertype 3) or be asserted by a host application with no row at all, and both are
# legitimate. Turn it off only if your users legitimately aren't in that collection.
WIDGET_VERIFY_ASSERTED_IDENTITY=true
# Per-role row caps for a generated report, same `role:limit` shape. REPORT_MAX_ROWS stays the
# absolute ceiling -- an override can only lower it. Rendering is the most expensive CPU on the
# request path and runs on a bounded pool, so this is a real load question once customers can
# reach it. Empty by default.
REPORT_MAX_ROWS_BY_ROLE=admin:1000,vendor:500,customer:100
# Whether a generated report may carry `email`/`phone` columns for rows the principal is ALREADY
# authorized to see -- a vendor exporting their own customer list, say. Off by default, and
# deliberately so: the model is never shown these fields, so this is the only way they can leave
# the system, and turning it on should be an operator's decision. A customer never gets contacts
# for the vendor directory even when this is on, because that list is unfiltered.
# See docs/authorization.md.
REPORT_INCLUDE_CONTACTS=false
